{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Socket: build",
      "type": "process",
      "command": "pnpm",
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Socket: watch",
      "type": "process",
      "command": "pnpm",
      "args": ["run", "watch"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Socket: test",
      "type": "process",
      "command": "pnpm",
      "args": ["test", "--all"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
