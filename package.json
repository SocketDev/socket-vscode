{
  "name": "vscode-socket-security",
  "displayName": "Socket Security",
  "version": "2.0.3",
  "description": "Editor integration with Socket Security",
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "Code Analysis",
    "Code Quality",
    "JavaScript",
    "Python",
    "Security",
    "Static Code Analysis",
    "TypeScript"
  ],
  "homepage": "https://socket.dev",
  "bugs": {
    "email": "support@socket.dev"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/SocketDev/vscode-socket-security"
  },
  "publisher": "SocketSecurity",
  "files": [
    "assets/repo/socket-icon-brand-256.png",
    "assets/repo/logo-*.svg",
    "LICENSE",
    "out/*.cjs",
    "out/*.go",
    "out/*.wasm"
  ],
  "type": "module",
  "main": "./out/main.cjs",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm run build:dev",
    "build:dev": "rolldown -c .config/repo/rolldown.config.mts",
    "build:prod": "MINIFY=1 rolldown -c .config/repo/rolldown.config.mts",
    "check": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "ci:fix": "node scripts/fleet/ci/fix/run.mts",
    "ci:gates": "node scripts/fleet/ci/gates/run.mts",
    "clean": "node scripts/repo/clean.mts",
    "cover": "node scripts/fleet/cover.mts",
    "cover:aggregate": "node scripts/fleet/cover-aggregate.mts",
    "fix": "pnpm run lint:fix && pnpm run format",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --config .config/repo/oxlint.config.mts .",
    "lint:fix": "oxlint --config .config/repo/oxlint.config.mts --fix .",
    "npm:dispatch": "node scripts/fleet/npm/publish/run.mts",
    "npm:release-record": "node scripts/fleet/release/record/run.mts",
    "package-for-vscode": "pnpm run build:prod && vsce package --no-dependencies",
    "prepublishOnly": "echo 'ERROR: Use GitHub Actions workflow for publishing' && exit 1",
    "release:nightly:plan": "node scripts/fleet/release/nightly/cli.mts",
    "setup:rust-coverage": "node scripts/fleet/setup/rust-coverage.mts",
    "test": "vitest run --config .config/repo/vitest.config.mts",
    "test:extension": "node scripts/repo/test-extension.mts",
    "test:extension-auth": "node scripts/repo/test-extension-auth.mts",
    "test:fuzz": "node scripts/repo/fuzz.mts",
    "typecheck": "tsc --noEmit -p .config/repo/tsconfig.json",
    "watch": "pnpm run build:dev --watch"
  },
  "dependencies": {
    "@socketsecurity/lib": "catalog:",
    "@socketsecurity/sdk": "catalog:",
    "@ultrathink/acorn.rs.wasm": "catalog:",
    "@vscode/python-extension": "1.0.6",
    "ini": "6.0.0",
    "local-json-wasm": "workspace:0.0.0",
    "local-toml-wasm": "workspace:0.0.0"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "catalog:",
    "@mdn/browser-compat-data": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@playwright/mcp": "catalog:",
    "@shadscan/cli": "catalog:",
    "@sinclair/typebox": "catalog:",
    "@socketregistry/packageurl-js": "catalog:",
    "@socketregistry/packageurl-js-stable": "catalog:",
    "@socketsecurity/lib-stable": "catalog:",
    "@socketsecurity/sdk-stable": "catalog:",
    "@types/ini": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@types/shell-quote": "catalog:",
    "@types/vscode": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "@vitiate/core": "catalog:",
    "@vscode/vsce": "catalog:",
    "ast-v8-to-istanbul": "catalog:",
    "ata-validator": "catalog:",
    "c8": "catalog:",
    "chrome-devtools-mcp": "catalog:",
    "fallow": "catalog:",
    "fast-check": "catalog:",
    "impeccable": "catalog:",
    "magic-string": "catalog:",
    "markdownlint-cli2": "catalog:",
    "mcp-tada": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-gfm": "catalog:",
    "mdast-util-to-markdown": "catalog:",
    "micromark": "catalog:",
    "micromark-extension-gfm": "catalog:",
    "neosanitize": "catalog:",
    "nock": "catalog:",
    "npm-high-impact": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "parse5": "catalog:",
    "playwright-core": "catalog:",
    "portless": "catalog:",
    "regjsparser": "catalog:",
    "rolldown": "catalog:",
    "run-local-ci": "catalog:",
    "semver": "catalog:",
    "shell-quote": "catalog:",
    "svgo": "catalog:",
    "taze": "catalog:",
    "typebox": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitiate": "catalog:",
    "yaml": "catalog:"
  },
  "contributes": {
    "authentication": [
      {
        "id": "socket-security",
        "label": "Socket Security"
      }
    ],
    "configuration": {
      "title": "Socket Security",
      "properties": {
        "socket-security.pythonInterpreter": {
          "order": 1,
          "type": "string",
          "scope": "machine",
          "description": "Path to a Python interpreter to use for Socket dependency analysis.",
          "examples": [
            "/usr/bin/python"
          ]
        },
        "socket-security.goExecutable": {
          "order": 2,
          "type": "string",
          "scope": "machine",
          "description": "Path to a Go executable to use for Socket dependency analysis.",
          "examples": [
            "/usr/bin/go"
          ]
        }
      }
    },
    "commands": [
      {
        "title": "Login",
        "category": "Socket Security",
        "command": "socket-security.login"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "socket-security.mcp-server",
        "label": "[Extension] Socket Security"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:go",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:python",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "workspaceContains:**/[gG][oO].[mM][oO][dD]",
    "workspaceContains:**/[gG][oO].[sS][uU][mM]",
    "workspaceContains:**/[pP][aA][cC][kK][aA][gG][eE].[jJ][sS][oO][nN]",
    "workspaceContains:**/[pP][iI][pP][fF][iI][lL][eE]",
    "workspaceContains:**/[pP][yY][pP][rR][oO][jJ][eE][cC][tT].[tT][oO][mM][lL]",
    "workspaceContains:**/[rR][eE][qQ][uU][iI][rR][eE][mM][eE][nN][tT][sS].[tT][xX][tT]"
  ],
  "icon": "assets/repo/socket-icon-brand-256.png",
  "preview": false,
  "devEngines": {
    "packageManager": [
      {
        "name": "npm",
        "version": ">=12.2.0",
        "onFail": "error"
      },
      {
        "name": "pnpm",
        "version": ">=12.12.0",
        "onFail": "error"
      }
    ]
  },
  "engines": {
    "node": ">=24",
    "npm": ">=12.2.0",
    "pnpm": ">=12.12.0",
    "vscode": "^1.134.0"
  },
  "allowScripts": {
    "cpu-features": false,
    "esbuild": true,
    "keytar": true,
    "protobufjs": false,
    "puppeteer": false,
    "ssh2": false
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Manifest and source scanning against the Socket API stays on. Analysis that would run a toolchain the workspace can choose \u2014 the Python interpreter and the Go build of the import finder \u2014 is disabled until you trust the workspace, and falls back to reading imports out of the source text.",
      "restrictedConfigurations": [
        "socket-security.goExecutable",
        "socket-security.pythonInterpreter"
      ]
    }
  },
  "tags": [
    "Code Analysis",
    "Code Quality",
    "JavaScript",
    "Python",
    "Security",
    "Static Code Analysis",
    "TypeScript"
  ]
}
