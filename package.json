{
  "name": "vscode-socket-security",
  "displayName": "Socket Security",
  "version": "2.0.3",
  "description": "Editor integration with Socket Security",
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "Code Analysis",
    "Code Quality",
    "JavaScript",
    "Python",
    "Security",
    "Static Code Analysis",
    "TypeScript"
  ],
  "homepage": "https://socket.dev",
  "bugs": {
    "email": "support@socket.dev"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/SocketDev/vscode-socket-security"
  },
  "publisher": "SocketSecurity",
  "files": [
    "out"
  ],
  "type": "commonjs",
  "main": "./out/main.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.mts",
    "check": "node scripts/fleet/check.mts",
    "check:paths": "node scripts/fleet/check/paths-are-canonical.mts",
    "clean": "node scripts/fleet/clean.mts",
    "compile": "rolldown -c rolldown.config.mts",
    "cover": "node scripts/fleet/cover.mts",
    "fix": "node scripts/fleet/fix.mts",
    "format": "node scripts/fleet/format.mts",
    "format:check": "node scripts/fleet/format.mts --check",
    "lint": "node scripts/fleet/lint.mts",
    "lockstep": "node scripts/fleet/lockstep.mts",
    "lockstep:emit-mirror-globs": "node scripts/fleet/lockstep-emit-mirror-globs.mts",
    "lockstep:emit-schema": "node scripts/fleet/lockstep-emit-schema.mts",
    "package-for-vscode": "vsce package --no-dependencies",
    "prepare": "node scripts/repo/bootstrap/prepare.mts && node scripts/fleet/install-git-hooks.mts && node scripts/fleet/prepare.mts",
    "prune:gha-caches": "node scripts/fleet/prune-actions-caches.mts",
    "security": "node scripts/fleet/security.mts",
    "test": "node scripts/fleet/test.mts",
    "test:fuzz": "node scripts/repo/fuzz.mts",
    "test-compile": "tsc -p tsconfig.json",
    "update": "node scripts/fleet/update.mts",
    "vscode:prepublish": "MINIFY=1 rolldown -c rolldown.config.mts",
    "vscode:uninstall": "node ./src/lifecycle/uninstall.mjs",
    "watch": "rolldown -c rolldown.config.mts --watch",
    "setup-security-tools": "node .claude/hooks/fleet/setup-security-tools/install.mts",
    "ci:local": "node scripts/fleet/agent-ci-skip-locks.mts run --all --quiet --pause-on-failure --github-token",
    "doctor:auth": "node scripts/fleet/check/setup-is-prompt-less.mts",
    "sync-oxlint-rules": "node scripts/fleet/sync-oxlint-rules.mts",
    "sync-package-manager-pins": "node scripts/fleet/sync-package-manager-pins.mts",
    "weekly-update": "node scripts/fleet/weekly-update.mts",
    "doctor": "node scripts/fleet/doctor.mts",
    "setup:brew": "node scripts/fleet/setup/brew.mts",
    "setup:go": "node scripts/fleet/setup/go.mts",
    "setup:mcp": "node scripts/fleet/setup/mcp.mts",
    "setup:python": "node scripts/fleet/setup/python.mts",
    "setup:refero": "node scripts/fleet/setup/refero.mts",
    "setup:rust": "node scripts/fleet/setup/rust.mts",
    "type": "node node_modules/typescript/bin/tsc --noEmit -p .config/fleet/tsconfig.check.json",
    "npm:publish": "node scripts/fleet/publish-pipeline.mts",
    "prepublishOnly": "echo 'ERROR: Use GitHub Actions workflow for publishing' && exit 1",
    "socket-wheelhouse:emit-schema": "node scripts/fleet/socket-wheelhouse-emit-schema.mts",
    "mcp:reset": "node scripts/fleet/mcp-reset.mts",
    "setup:sfw-ca": "node scripts/fleet/setup/sfw-ca.mts",
    "get-green": "node scripts/fleet/get-green.mts",
    "weekly-update:ci": "gh workflow run weekly-update.yml",
    "sync-fleet": "node scripts/repo/bootstrap/fleet.mjs",
    "fleet:status": "node scripts/repo/bootstrap/fleet.mjs --status",
    "strip:ai-tags": "node scripts/fleet/strip-ai-tags.mts",
    "npm:approve": "node scripts/fleet/publish-pipeline.mts --approve",
    "npm:auth": "node scripts/fleet/npm-auth.mts",
    "npm:dispatch": "gh workflow run npm-publish-packages.yml -R SocketDev/socket-registry --ref main -f publish=true",
    "npm:login": "node scripts/fleet/npm-web-auth.mts login",
    "npm:staged": "node scripts/fleet/publish-pipeline.mts --status",
    "hide-comments": "node scripts/fleet/hide-comments.mts",
    "ruleset:bypass": "node scripts/fleet/grant-ruleset-bypass.mts",
    "soak:bypass": "node scripts/fleet/soak-bypass.mts",
    "npm:trust": "node scripts/fleet/registry-infra/npm/trust.mts",
    "prune:branch-backups": "node scripts/fleet/backup-branches.mts prune",
    "preflight": "node scripts/fleet/preflight.mts",
    "npm:auth:browser": "node scripts/fleet/npm-auth-browser.mts",
    "npm:auth:cli": "node scripts/fleet/npm-auth-cli.mts"
  },
  "dependencies": {
    "@socketsecurity/lib": "catalog:",
    "@socketsecurity/sdk": "catalog:",
    "@ultrathink/acorn.rs.wasm": "catalog:",
    "@vscode/python-extension": "1.0.6",
    "ini": "6.0.0",
    "socket-vscode-vendor-json-wasm": "workspace:0.0.0",
    "socket-vscode-vendor-toml-wasm": "workspace:0.0.0"
  },
  "devDependencies": {
    "@playwright/mcp": "catalog:",
    "@redwoodjs/agent-ci": "catalog:",
    "@shadscan/cli": "catalog:",
    "@sinclair/typebox": "catalog:",
    "@socketregistry/packageurl-js": "catalog:",
    "@socketregistry/packageurl-js-stable": "catalog:",
    "@socketsecurity/lib-stable": "catalog:",
    "@socketsecurity/sdk-stable": "catalog:",
    "@types/ini": "4.1.1",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@types/shell-quote": "catalog:",
    "@types/vscode": "1.125.0",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "@vitiate/core": "catalog:",
    "@vscode/vsce": "3.9.2",
    "c8": "catalog:",
    "chrome-devtools-mcp": "catalog:",
    "fast-check": "catalog:",
    "impeccable": "catalog:",
    "magic-string": "catalog:",
    "markdownlint-cli2": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-gfm": "catalog:",
    "mdast-util-to-markdown": "catalog:",
    "micromark": "catalog:",
    "micromark-extension-gfm": "catalog:",
    "neosanitize": "catalog:",
    "nock": "catalog:",
    "npm-high-impact": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "parse5": "catalog:",
    "playwright-core": "catalog:",
    "portless": "catalog:",
    "regjsparser": "catalog:",
    "rolldown": "catalog:",
    "semver": "catalog:",
    "shell-quote": "catalog:",
    "svgo": "catalog:",
    "taze": "catalog:",
    "typebox": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitiate": "catalog:"
  },
  "contributes": {
    "configuration": {
      "title": "Socket Security",
      "properties": {
        "socket-security.pythonInterpreter": {
          "order": 1,
          "type": "string",
          "scope": "machine",
          "description": "Path to a Python interpreter to use for Socket dependency analysis.",
          "examples": [
            "/usr/bin/python"
          ]
        },
        "socket-security.goExecutable": {
          "order": 2,
          "type": "string",
          "scope": "machine",
          "description": "Path to a Go executable to use for Socket dependency analysis.",
          "examples": [
            "/usr/bin/go"
          ]
        }
      }
    },
    "commands": [
      {
        "title": "Login",
        "category": "Socket Security",
        "command": "socket-security.login"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "socket-security.mcp-server",
        "label": "[Extension] Socket Security"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:go",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:python",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "workspaceContains:**/[gG][oO].[mM][oO][dD]",
    "workspaceContains:**/[gG][oO].[sS][uU][mM]",
    "workspaceContains:**/[pP][aA][cC][kK][aA][gG][eE].[jJ][sS][oO][nN]",
    "workspaceContains:**/[pP][iI][pP][fF][iI][lL][eE]",
    "workspaceContains:**/[pP][yY][pP][rR][oO][jJ][eE][cC][tT].[tT][oO][mM][lL]",
    "workspaceContains:**/[rR][eE][qQ][uU][iI][rR][eE][mM][eE][nN][tT][sS].[tT][xX][tT]"
  ],
  "icon": "assets/socket-icon-brand-256.png",
  "preview": false,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24",
    "npm": ">=12.0.2",
    "pnpm": ">=11.0.5",
    "vscode": "^1.125.0"
  },
  "allowScripts": {
    "cpu-features": false,
    "esbuild": true,
    "keytar": true,
    "protobufjs": false,
    "puppeteer": false,
    "ssh2": false
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Manifest and source scanning against the Socket API stays on. Analysis that would run a toolchain the workspace can choose — the Python interpreter and the Go build of the import finder — is disabled until you trust the workspace, and falls back to reading imports out of the source text.",
      "restrictedConfigurations": [
        "socket-security.goExecutable",
        "socket-security.pythonInterpreter"
      ]
    }
  },
  "npm-run-all2": {
    "nodeRun": true
  },
  "tags": [
    "Code Analysis",
    "Code Quality",
    "JavaScript",
    "Python",
    "Security",
    "Static Code Analysis",
    "TypeScript"
  ]
}
